# .env.pages-rgb.example — TEMPLATE para ptr.rotadeataque.com.br + R2 (mesma conta Rota)
# COPIE para .env.pages-rgb e preencha. Este arquivo é commitado como exemplo (sem segredos).
# O deploy lê .env.pages-rgb em /srv/pages-to-rgb/config/.env (não o .env do Rota).

# ── App (mesmo WSL2 do Rota, mas projeto isolado) ──
APP_ENV=production
APP_NAME=pages-to-rgb
APP_BASE_URL=https://ptr.rotadeataque.com.br
LOG_LEVEL=INFO

# Banco — a IA cria DB separado pages_to_rgb (não misturar com pages_to_audio nem rota_ataque)
# WSL2 Postgres nativo 18, PgBouncer 6432. A IA faz: CREATE DATABASE pages_to_rgb; CREATE USER pages_to_rgb; GRANT;
# e grava DATABASE_URL abaixo (auto):
DATABASE_URL=postgresql+asyncpg://pages_to_rgb:__AUTO__@172.29.52.81:5432/pages_to_rgb

# Auth gateway — a IA reutiliza APIs do Rota (CREDENCIAIS_ROTA.txt:20 sk-156e1c... DeepSeek etc) quando possível
# Para PTR pode copiar token local dev-gateway-token ou gerar novo; a IA grava auto:
ANDROID_GATEWAY_TOKEN=__AUTO__dev-gateway-token
ANDROID_GATEWAY_TOKEN_PREVIOUS=
DEVICE_HMAC_MASTER_KEY=__AUTO__

# ── R2 — MESMA CONTA do Rota (rota-arquivos), buckets ptr- separados ──
# A IA executora lê CREDENCIAIS_ROTA.txt:32 (Account/Access/Secret/Token) e cria os buckets se não existirem:
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=__AUTO__  # de CREDENCIAIS_ROTA.txt:32
R2_ACCESS_KEY_ID=__AUTO__
R2_SECRET_ACCESS_KEY=__AUTO__
R2_ENDPOINT=https://__R2_ACCOUNT_ID__.r2.cloudflarestorage.com
R2_BUCKET_ORIGINALS=pages-to-rgb-originals  # auto-criado
R2_BUCKET_DERIVED=pages-to-rgb-derived
R2_BUCKET_OCR_RAW=pages-to-rgb-ocr
R2_BUCKET_AUDIO=pages-to-rgb-audio
R2_BUCKET_KNOWLEDGE=pages-to-rgb-knowledge
# Lifecycle 90 dias: a IA configura via API (Expiration Days 90) — fotos/provas/respostas do PTR deletadas automaticamente

# Supabase legado — deixar vazio após migração R2 (mantido só para não quebrar import)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── Tunnel/DNS — MESMA ZONE rotadeataque.com.br, novo tunnel ptr ──
# A IA lê CREDENCIAIS_ROTA.txt:32 (Account/Token) e cria: cloudflared tunnel create pages-to-rgb-wsl2 + route dns ptr.rotadeataque.com.br
DOMAIN=ptr.rotadeataque.com.br  # fixo, sem custo
CLOUDFLARE_ZONE_ID=__AUTO__  # de Dashboard rotadeataque.com.br (a IA busca via API com Token DNS)
CLOUDFLARE_API_TOKEN=__AUTO__  # de CREDENCIAIS_ROTA.txt:37
TUNNEL_NAME=pages-to-rgb-wsl2
TUNNEL_ID=__AUTO__  # novo ID (não o 17a16fd2 do Rota)
TUNNEL_TOKEN=__AUTO__  # eyJhI... cred file /etc/cloudflared/<ID>.json

# ── GitHub isolado ──
GITHUB_REPO=https://github.com/leoalvespak-alt/pages_to_rgb.git
# GITHUB_PAT só se git push pedir auth (Fine-grained PAT → repo pages_to_rgb → Contents:Write)
GITHUB_PAT=

# ── WSL2 / Deploy isolado (não conflita com Rota) ──
WSL_DISTRO=Ubuntu
WSL_PROJECT_PATH=/srv/pages-to-rgb
PAGES_RGB_CADDY_PORT=8080   # tunnel ptr → http://localhost:8080 (Rota usa 80)
PAGES_RGB_APP_PORT=8001     # FastAPI em 8001 (Rota usa 3000)
DOCKER_COMPOSE_FILE=docker-compose.pages-rgb.prod.yml
LOCKFILE=/tmp/pages-rgb-deploy.lock

# ── Captura / IA (reusa EXAME, mas sessão HANDWRITTEN_WORD = 10 fotos) ──
DEFAULT_EXPECTED_PAGES=10
DEFAULT_EXPECTED_QUESTIONS=10
HANDWRITTEN_PALETTE_MAPPING=João:Azul 0,0,255/Maria:Vermelho 255,0,0/Pedro:Verde 0,255,0/Paula:Roxo 128,0,128/Fernanda:Amarelo 255,255,0

# ── TTL local + limpeza ──
LOCAL_TEMP_ROOT=/tmp/pages-to-rgb
LOCAL_TEMP_TTL_HOURS=6
R2_LIFECYCLE_DAYS=90

# ── O que já está OK em C:\Users\Lenovo\Downloads\pagestoaudio_servidor\.env ──
# ANDROID_GATEWAY_TOKEN=dev-gateway-token (local)
# DATABASE_URL local 172.29.52.81:5432/pages_to_audio (precisa novo DB pages_to_rgb)
# RGB defaults 12%/3000/5000, TEMPORAL_ADDRESS 172.29.52.81:7233 (pode reusar)
# Admin authentication and encrypted provider settings
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
CSRF_SECRET=
ADMIN_SETTINGS_ENCRYPTION_KEY=
ADMIN_SESSION_TTL_DAYS=30
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=300
