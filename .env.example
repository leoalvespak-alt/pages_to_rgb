APP_ENV=development
APP_NAME=pages-to-audio
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Buckets (Anexo B-2)
SUPABASE_BUCKET_ORIGINALS=pages-originals
SUPABASE_BUCKET_DERIVED=pages-derived
SUPABASE_BUCKET_OCR_RAW=ocr-raw
SUPABASE_BUCKET_KNOWLEDGE=knowledge
SUPABASE_BUCKET_AUDIO=audio
SUPABASE_BUCKET_AUDIT=audit-exports

ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
CSRF_SECRET=

ANDROID_GATEWAY_TOKEN=
ANDROID_GATEWAY_TOKEN_PREVIOUS=
DEVICE_HMAC_MASTER_KEY=
DEVICE_REPLAY_WINDOW_SECONDS=300

TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=pages-to-audio
TEMPORAL_TASK_QUEUE=pages-to-audio-main
TEMPORAL_TLS=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SOLVER=claude-opus-5
ANTHROPIC_MODEL_VERIFIER=claude-opus-5
ANTHROPIC_MODEL_ARBITER=claude-opus-5

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FALLBACK_ENABLED=true
DEEPSEEK_CROSSCHECK_ON_HIGH_RISK=false

GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

PADDLE_OCR_ENABLED=false
PADDLE_OCR_REMOTE_URL=

TTS_PROVIDER=google
TTS_FALLBACK_PROVIDER=azure
GOOGLE_TTS_CREDENTIALS=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

WEB_SEARCH_ENABLED=true

DEFAULT_EXPECTED_PAGES=30
DEFAULT_EXPECTED_QUESTIONS=70
DEFAULT_MINIMUM_RATIO=0.90

LOCAL_TEMP_ROOT=/tmp/pages-to-audio
LOCAL_TEMP_MAX_GB=2
LOCAL_TEMP_TTL_HOURS=6

MAX_IMAGE_PROCESSING_CONCURRENCY=1
MAX_OCR_CONCURRENCY=3
MAX_LLM_CONCURRENCY=4
MAX_AUDIO_CONCURRENCY=1

MAX_RECONSTRUCTION_RESCUE_ROUNDS=3
MAX_ANSWER_RESCUE_ROUNDS=3

IDEMPOTENCY_TTL_HOURS=48

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=pages-to-audio

# Feature flags
RERANKER_ENABLED=false
STATUS_AUDIO_ENABLED=true
RGB_RESULTS_ENABLED=true
RGB_SEQUENCE_SCHEMA_VERSION=1
RGB_SEQUENCE_MAX_ITEMS=1000
RGB_SEQUENCE_MAX_JSON_BYTES=262144
RGB_DEFAULT_BRIGHTNESS_PERCENT=12
RGB_DEFAULT_ON_MS=3000
RGB_DEFAULT_OFF_MS=5000
